# LLM Provider Configuration
# 可选：anthropic / openai / deepseek / qwen / zhipu / moonshot / baichuan / yi /
#       minimax / stepfun / siliconflow / mimo / ollama / custom
# 每家都是 <PROVIDER>_API_KEY + <PROVIDER>_MODEL（+ 需要时的 <PROVIDER>_BASE_URL），
# 下面只列四家常问的，其余按同样的命名补上即可。
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o

# DeepSeek (OpenAI compatible)
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Ollama (local, OpenAI compatible)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# ── Web search / fetch (DeepSeek Search & Fetch) ──
# 主模型是 DeepSeek 时留空即可，会自动复用 DEEPSEEK_API_KEY。
# 主模型换成 Claude / OpenAI / Ollama 时，单独填一个 DeepSeek Key，
# web_search / web_fetch 依然走官方接口（按成功请求计费，5 元 / 1000 次）。
# WEB_SEARCH_API_KEY=sk-xxx
# auto（默认）/ deepseek（强制官方）/ free（永不调用接口，只用 DDG + Bing）
# WEB_SEARCH_BACKEND=auto
# WEB_SEARCH_BASE_URL=          # 默认 https://api.deepseek.com

# Common
# 单次回复的输出上限。GUI 的设置页可以覆盖它（上下文与输出 → 单次输出上限）。
# 思考型模型的 reasoning 也算在 completion tokens 里：上限太小会在思考中途
# 被截断，连工具调用都发不出来（日志里表现为"想很久、没动作"）。这类模型
# 建议至少 32768，并把思考强度调低（见下面的 LLM_THINKING_LEVEL）。
MAX_TOKENS=16384
TEMPERATURE=0.0

# 思考强度（GUI 设置页 → 思考强度 会覆盖这里）：
#   default = 不发参数，沿用厂商默认 | off = 尽量关闭
#   low / medium / high = 具体档位
# 不同厂商字段名完全不同（OpenAI reasoning_effort、Anthropic thinking.budget_tokens、
# Qwen enable_thinking + thinking_budget、GLM thinking.type ...），映射表见
# src/gangge/layer5_llm/thinking.py；不支持的厂商不会收到任何额外字段。
# 旧的 LLM_REASONING_EFFORT 仍被识别，作为本变量的兜底。
# LLM_THINKING_LEVEL=medium
# 厂商私有开关，JSON 对象，优先级高于自动映射。例如关闭思考：
# LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}

# ── Context (GUI 设置页可覆盖，这里只是默认值) ──
# 模型上下文窗口，支持 128K / 1M / 131072 这类写法。
# 只影响"用到 92% 就自动压缩"的触发点与占用率显示，不会让模型真的变强。
# CONTEXT_WINDOW_TOKENS=128K
# 滑动窗口：只保留最近 N 轮对话（超出丢弃）。新模型上下文大可以调大。
# MAX_HISTORY_ROUNDS=6
# 单条工具输出保留的字符上限（超出截掉中间，保留头尾）。
# TOOL_RESULT_MAX_CHARS=6000
# 模型"只思考、不调工具"的轮次：思考内容不会回传给 API，不落笔记的话下一轮
# 等于失忆，会从头再想一遍。开启后把该轮思考压成一条 user 消息注入下一轮。
# THINKING_CARRYOVER=1
# THINKING_CARRYOVER_MAX_CHARS=1200
# 连续多少轮空转后收尾（保留未完成待办，留待"继续"）。默认 2。
# MAX_IDLE_ROUNDS=2

# ── Vision / image recognition ──
# Leave VISION_MODEL empty when the main model already accepts images
# (claude-sonnet-*, gpt-4o, qwen-vl-*...). Text-only mains such as
# deepseek-chat must point VISION_MODEL at a VL model, otherwise the
# vision tool reports "configure VISION_MODEL" instead of failing at the API.
# VISION_PROVIDER=qwen
# VISION_MODEL=qwen-vl-max
# VISION_BASE_URL=          # defaults to <PROVIDER>_BASE_URL
# VISION_API_KEY=           # defaults to <PROVIDER>_API_KEY
# VISION_MAX_TOKENS=4096

# Language (zh / en, auto-detected if not set)
# GANGGE_LANG=en

# Workspace
WORKSPACE_DIR=.
