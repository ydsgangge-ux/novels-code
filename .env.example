# LLM Provider Configuration
# Choose one: anthropic, openai, deepseek, ollama
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o

# DeepSeek (OpenAI compatible)
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Ollama (local, OpenAI compatible)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# Common
MAX_TOKENS=8192
TEMPERATURE=0.0

# ── Vision / image recognition ──
# Leave VISION_MODEL empty when the main model already accepts images
# (claude-sonnet-*, gpt-4o, qwen-vl-*...). Text-only mains such as
# deepseek-chat must point VISION_MODEL at a VL model, otherwise the
# vision tool reports "configure VISION_MODEL" instead of failing at the API.
# VISION_PROVIDER=qwen
# VISION_MODEL=qwen-vl-max
# VISION_BASE_URL=          # defaults to <PROVIDER>_BASE_URL
# VISION_API_KEY=           # defaults to <PROVIDER>_API_KEY
# VISION_MAX_TOKENS=4096

# Language (zh / en, auto-detected if not set)
# GANGGE_LANG=en

# Workspace
WORKSPACE_DIR=.
